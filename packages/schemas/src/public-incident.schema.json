{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syosint.org/schemas/public-incidents/1.0.0",
  "title": "syOSINT public incident dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "synthetic", "incidents"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "synthetic": { "const": true },
    "incidents": {
      "type": "array",
      "items": { "$ref": "#/$defs/incident" }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ar"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ar": { "type": "string", "minLength": 1 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ar", "precision"],
      "dependentRequired": {
        "latitude": ["longitude"],
        "longitude": ["latitude"]
      },
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ar": { "type": "string", "minLength": 1 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "precision": {
          "enum": ["country", "governorate", "district", "withheld"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": { "enum": ["country", "withheld"] }
            },
            "required": ["precision"]
          },
          "then": {
            "properties": {
              "latitude": false,
              "longitude": false
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url", "publishedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/localizedText" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctedAt", "reason", "changedFields"],
      "properties": {
        "correctedAt": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "#/$defs/localizedText" },
        "changedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "categories",
        "confidence",
        "occurredAt",
        "updatedAt",
        "location",
        "title",
        "summary",
        "uncertainty",
        "sourceCount",
        "sources",
        "corrections"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "status": { "enum": ["published", "corrected", "withdrawn"] },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "armed-conflict",
              "political-security",
              "humanitarian",
              "infrastructure",
              "border-crossing",
              "disinformation"
            ]
          }
        },
        "confidence": {
          "enum": ["unverified", "developing", "corroborated", "verified", "disputed", "false"]
        },
        "occurredAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "location": { "$ref": "#/$defs/location" },
        "title": { "$ref": "#/$defs/localizedText" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "uncertainty": { "$ref": "#/$defs/localizedText" },
        "sourceCount": { "type": "integer", "minimum": 0 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "corrections": {
          "type": "array",
          "items": { "$ref": "#/$defs/correction" }
        }
      }
    }
  }
}
