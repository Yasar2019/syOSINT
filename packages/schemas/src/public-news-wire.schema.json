{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syosint.org/schemas/public-news-wire/1.0.0",
  "title": "syOSINT public news wire",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "lastSuccessfulRefreshAt",
    "sources",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "lastSuccessfulRefreshAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthy", "delayed"],
      "properties": {
        "healthy": { "type": "integer", "minimum": 0 },
        "delayed": { "type": "integer", "minimum": 0 }
      }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ar"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ar": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "sourceLabel",
        "language",
        "headline",
        "url",
        "publishedAt",
        "collectedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "sourceLabel": { "$ref": "#/$defs/localizedText" },
        "language": { "enum": ["en", "ar"] },
        "headline": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "collectedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
