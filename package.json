{
  "name": "syosint",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @syosint/public-dashboard build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:api": "python -m pytest services/collector-api/tests -q",
    "test:rss": "python -m pytest services/collector-api/tests/test_rss_*.py -q",
    "collect:rss:public": "python -m syosint.rss_cli collect-public --config config/rss-sources.json --output data/public/news-wire.v1.json",
    "build:desk": "pnpm --filter @syosint/analyst-desk build",
    "test:e2e": "pnpm --filter @syosint/public-dashboard test:e2e",
    "policy:check": "secretlint \"**/*\" --secretlintignore .gitignore"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^10.2.2",
    "secretlint": "^10.2.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
